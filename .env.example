# start.ps1 e npm start carregam .env local, se existir.
# Somente sandbox está implementado. PAYMENT_MODE=live impede a inicialização.
PAYMENT_MODE=sandbox
PORT=3000
PIX_BANK=santander
PIX_KEY_TYPE=cnpj
PIX_KEY=
# Preencha somente em .env local. Não enviar segredos pelo chat.
# A integração bancária ainda não está implementada; estes campos são reservados.
# SANTANDER_CLIENT_ID=
# SANTANDER_CLIENT_SECRET=
# SANTANDER_CERT_PATH=
# SANTANDER_KEY_PATH=
# Chave HMAC opcional para testes de notificações servidor-servidor; mínimo 32 caracteres.
# Sem esta chave, /api/webhooks/sandbox retorna 503.
SANDBOX_WEBHOOK_SECRET=
# Política de preços de teste em BRL (não é conversão dos preços em euros).
# Recarga: R$20 = 100 GOLD. TOP: 40 GOLD. VIP: 250 GOLD.
# Antes de produção: escolher instituições, obter aprovação comercial do segmento,
# implementar seus adaptadores, webhooks, reconciliação, estornos e checkout hospedado.
# Cripto: definir moeda/rede, câmbio, confirmação on-chain e destino empresarial.
# Não armazenar número de cartão, CVV, seed phrase ou chave privada neste serviço.
